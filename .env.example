# Copy this file to .env and fill in real values. Never commit .env to git.

# Port the backend listens on
PORT=8787

# Comma-separated list of origins allowed to call this API.
# Add your Blogger domain(s) here, e.g. https://yourblog.blogspot.com
ALLOWED_ORIGINS=https://yourblog.blogspot.com,http://localhost:3000

# --- SERP provider ---
# This project uses Serper.dev (https://serper.dev) because it has a simple
# REST API and a generous free tier. Swap providers in utils/serp.js if you
# prefer SerpApi or another vendor — keep the key on the backend either way.
SERPER_API_KEY=your_serper_dev_api_key_here

# --- Optional: rendering service for JS-heavy pages ---
# If a target site needs JavaScript to render its headings, plain axios+cheerio
# scraping will miss them. Leave this blank to skip JS rendering (most blog
# posts are static HTML and don't need it). If you have a rendering API
# (e.g. ScrapingBee, Browserless), put its key here and wire it up in
# utils/scrape.js where marked.
RENDER_API_KEY=

# Request limits
SCRAPE_TIMEOUT_MS=10000
MAX_RESPONSE_BYTES=3000000
